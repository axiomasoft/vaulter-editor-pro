{
  "name": "@vaulter/editor-pro-vue",
  "version": "1.0.0",
  "description": "Vue 3 + TipTap OSS components, composables and diff/anchor utilities for Vaulter Editor Pro Review.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.13.1"
  },
  "type": "module",
  "vaulter": {
    "api": "1"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/vaulter-editor-pro-vue.umd.cjs",
  "module": "./dist/vaulter-editor-pro-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vaulter-editor-pro-vue.js",
      "require": "./dist/vaulter-editor-pro-vue.umd.cjs"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@vaulter/vue": "^1.0.0",
    "vue": "^3.5.42",
    "yjs": "^13.6.33"
  },
  "peerDependenciesMeta": {
    "@vaulter/vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "@vaulter/editor-pro-docx": "^1.0.0",
    "prosemirror-changeset": "^2.4.4",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@vaulter/vue": "file:../../../vaulter/packages/vue",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.42",
    "vue-tsc": "^2.1.0"
  }
}
