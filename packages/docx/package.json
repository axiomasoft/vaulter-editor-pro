{
  "name": "@vaulter/editor-pro-docx",
  "version": "1.0.0",
  "description": "Isomorphic DOCX/OOXML <-> intermediate model <-> TipTap JSON & review converter for Vaulter Editor Pro.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.13.1"
  },
  "type": "module",
  "vaulter": {
    "api": "1"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js",
        "require": "./dist/browser.cjs"
      },
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "require": "./dist/node.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "9.16.0",
    "fast-xml-parser": "^5.3.5",
    "fflate": "0.8.3",
    "saxes": "6.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/yauzl": "3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10"
  }
}
