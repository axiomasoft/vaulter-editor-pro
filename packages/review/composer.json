{
    "name": "axiomasoft/vaulter-editor-pro-review",
    "description": "Vaulter Editor Pro — revision pinning, preview/compare and generation-scoped range comment anchors. PHP 8.2 and 8.3 are not supported.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-editor-pro",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "axiomasoft/vaulter-core": "self.version",
        "axiomasoft/vaulter-documents": "self.version",
        "axiomasoft/vaulter-drive": "self.version",
        "ext-mbstring": "*",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "axiomasoft/vaulter-collaboration": "Required for accepting or rejecting suggestions on documents in collaboration journal mode."
    },
    "require-dev": {
        "axiomasoft/packman-testkit": "^0.1",
        "axiomasoft/vaulter-collaboration": "self.version",
        "axiomasoft/vaulter-media": "self.version",
        "larastan/larastan": "^3.15",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "~2.3.7"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\EditorPro\\Review\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\EditorPro\\Review\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "schema-version": 1,
            "package-type": "addon",
            "stability": "stable",
            "error-prefix": "review"
        },
        "laravel": {
            "providers": [
                "Vaulter\\EditorPro\\Review\\EditorProReviewServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
