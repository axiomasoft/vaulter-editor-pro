{
    "name": "axiomasoft/vaulter-editor-pro-monorepo",
    "description": "Vaulter Editor Pro — review, comments, compare and DOCX (private monorepo workspace).",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-editor-pro",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter-editor-pro/issues",
        "source": "https://github.com/axiomasoft/vaulter-editor-pro"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-editor-pro-review": "1.0.x-dev",
                    "axiomasoft/vaulter-editor-pro-exchange": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../vaulter-collaboration/packages/collaboration",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-collaboration": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../vaulter/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-core": "1.0.x-dev",
                    "axiomasoft/vaulter-documents": "1.0.x-dev",
                    "axiomasoft/vaulter-drive": "1.0.x-dev",
                    "axiomasoft/vaulter-media": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.2",
                    "axiomasoft/packman-devtools": "0.1.2",
                    "axiomasoft/packman-plugins": "0.1.2",
                    "axiomasoft/packman-schema": "0.1.2",
                    "axiomasoft/packman-testkit": "0.1.2"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-editor-pro-exchange": "^1.0",
        "axiomasoft/vaulter-editor-pro-review": "^1.0"
    },
    "require-dev": {
        "axiomasoft/packman-testkit": "^0.1",
        "axiomasoft/vaulter-collaboration": "^1.0",
        "axiomasoft/vaulter-drive": "^1.0",
        "axiomasoft/vaulter-media": "^1.0",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "~2.3.7",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "spaze/phpstan-disallowed-calls": "^4.15.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\EditorPro\\Ci\\": "scripts/ci/",
            "Vaulter\\EditorPro\\Exchange\\Tests\\": "packages/exchange/tests/",
            "Vaulter\\EditorPro\\Review\\Tests\\": "packages/review/tests/"
        }
    },
    "extra": {
        "phpstan/extension-installer": {
            "ignore": [
                "larastan/larastan",
                "nesbot/carbon",
                "pestphp/pest",
                "phpstan/phpstan-strict-rules",
                "spaze/phpstan-disallowed-calls"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 1800,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/pint",
        "lint:check": "@php vendor/bin/pint --test",
        "docx:cli": "sh scripts/ensure-docx-cli.sh",
        "test": [
            "@docx:cli",
            "@php vendor/bin/pest -c phpunit.xml.dist --testsuite=review --test-directory=packages/review/tests",
            "@php vendor/bin/pest -c phpunit.xml.dist --testsuite=exchange --test-directory=packages/exchange/tests"
        ],
        "test:parallel": [
            "@docx:cli",
            "@php vendor/bin/pest -c phpunit.xml.dist --parallel"
        ],
        "docs:errors": [
            "@putenv VAULTER_UPDATE_DOCS=1",
            "@php vendor/bin/pest -c phpunit.xml.dist --filter=\"docs/reference/errors.md\""
        ],
        "phpstan": "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --memory-limit=1G --no-progress"
    },
    "scripts-descriptions": {
        "docx:cli": "Build packages/docx/dist/cli.js when it is missing or older than its sources (used by the exchange tests).",
        "test": "Run the review and exchange suites one after the other (any DB_CONNECTION).",
        "test:parallel": "Run both suites in parallel workers (one per CPU). On a server database set VAULTER_TEST_DB_PER_PROCESS=1 and create <DB_DATABASE without _test>_w<N>_test for N = 1..CPUs.",
        "docs:errors": "Regenerate the generated tables in docs/reference/errors.md from the problem catalogue."
    }
}
