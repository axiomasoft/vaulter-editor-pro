<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnEmptyTestSuite="true"
>
    <testsuites>
        <testsuite name="review">
            <directory>packages/review/tests</directory>
        </testsuite>
        <testsuite name="exchange">
            <directory>packages/exchange/tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>packages/review/src</directory>
            <directory>packages/exchange/src</directory>
        </include>
    </source>

    <php>
        <env name="APP_KEY" value="base64:tJ4mVwShl8LETWdRtTCwcoKS7MS2ipekchk9seHrIVc="/>
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
    </php>
</phpunit>
